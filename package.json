{
  "name": "raw-signal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:smoke": "node --test tests/critical-journey.test.mjs",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "check": "npm test && npm run lint && npm run test:browser",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "data:sync:singles": "node sync-tcgcsv.mjs",
    "data:sync:sealed": "node sync-sealed.mjs",
    "data:reconcile:scalper": "node scripts/scalper/reconcile.mjs",
    "data:build:scalper": "node scripts/scalper/build-feed.mjs",
    "data:build:details": "node scripts/details/build-detail-feeds.mjs --enrich",
    "db:generate": "drizzle-kit generate",
    "cloudflare:prepare:staging": "node scripts/cloudflare/prepare-deployment.mjs --environment staging",
    "cloudflare:prepare:production": "node scripts/cloudflare/prepare-deployment.mjs --environment production",
    "cloudflare:parity": "node scripts/cloudflare/catalog-parity.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
